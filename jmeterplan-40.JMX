        <hashTree>
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Assert: overview loads within 10 s" enabled="true">
            <stringProp name="TestElement.comments">Duration Assertion. Fails if the page takes longer than 10,000 ms, which is a performance check.</stringProp>
            <stringProp name="DurationAssertion.duration">10000</stringProp>
