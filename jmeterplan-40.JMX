                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
                <stringProp name="Argument.name">password</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert: login reached Accounts Overview" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="-1771718541">Accounts Overview</stringProp>
            </collectionProp>
            <stringProp name="TestElement.comments">Response Assertion (Text contains). After a successful login ParaBank shows Accounts Overview.</stringProp>
            <stringProp name="Assertion.custom_message">Login failed - check the username/password variables. ParaBank may have reset its database: re-register and update the variables.</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
