          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="300 ms delay" enabled="true">
            <stringProp name="TestElement.comments">Requirement: wait 300 ms BEFORE loading the home page. A timer placed under a request runs before that request.</stringProp>
            <stringProp name="ConstantTimer.delay">300</stringProp>
          </ConstantTimer>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert: home page shows Customer Login" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="-575504217">Customer Login</stringProp>
            </collectionProp>
            <stringProp name="TestElement.comments">Response Assertion (Text contains). Proves the real home page loaded, not an error page.</stringProp>
